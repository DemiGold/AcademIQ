# ============================================
# ROOT .gitignore — guards all subprojects
# ============================================

# Environment — NEVER COMMIT
.env
.env.*
.env.local
.env.development
.env.production
**/.env
**/.env.*
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
web-build/
**/dist/
**/build/

# Expo
.expo/
.expo-shared/
**/.expo/

# Native build artifacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
ios/
android/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Testing
coverage/

# Backups
AcademIQ-backup-*
*-backup-*

# Misc
combined_codebase.txt
academiq-full-codebase.txt
extract-all.sh
extract-code.sh.env
.env.local
supabase/
